# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only values. Never expose these in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=generate-a-long-random-secret
OPENAI_API_KEY=your-openai-api-key

# Professional billing mode:
# launch_offer = one-time activation now, 60 days active, then invite monthly subscription.
# standard_subscription = monthly Mercado Pago subscription from day 1.
PROFESSIONAL_BILLING_MODE=launch_offer

# Pix
NEXT_PUBLIC_PIX_KEY=your-pix-key-uuid-or-email
NEXT_PUBLIC_PIX_WHATSAPP=5521999999999

# Development only. Demo properties are disabled by default.
# NEXT_PUBLIC_ENABLE_DEMO_PROPERTIES=true

# Destaques pagos en home/listas solo para anuncios creados despues de esta fecha (UTC).
# Los anteriores quedan como regalo admin en carrusel y topo das buscas.
# FEATURED_PAYMENTS_START_ISO=2026-07-15T03:00:00.000Z
