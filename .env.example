# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Servidor (Vercel) — nunca expor no client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron diario de anuncios vencidos (/api/cron/expire-listings)
CRON_SECRET=generate-a-long-random-secret

# Pix Potilar
NEXT_PUBLIC_PIX_KEY=your-pix-key-uuid-or-email
NEXT_PUBLIC_PIX_WHATSAPP=5521999999999

# Dev only: imoveis demo Unsplash (desligado por padrao)
# NEXT_PUBLIC_ENABLE_DEMO_PROPERTIES=true
